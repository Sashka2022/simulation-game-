# Optional, non-secret deployment settings
# DATA_DIR=/persistent/hadar-data
# APP_ORIGIN=https://your-domain.example
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# Vercel + Neon: created by connecting the database integration.
# DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
# POSTGRES_URL is also supported when provided by an existing integration.
# Never use a NEXT_PUBLIC_ prefix for a database connection string.
